MYAI_APP_NAME=MY-AI
MYAI_ENVIRONMENT=development
MYAI_LOG_LEVEL=INFO

# Primary/simple provider (used for chat mode)
MYAI_MODEL_PROVIDER=local
MYAI_MODEL_NAME=placeholder-v7
MYAI_MODEL_BASE_URL=http://localhost:11434
MYAI_MODEL_API_KEY=
MYAI_MODEL_TIMEOUT_SECONDS=60

# V7.1 tiered multi-model execution
# Set each provider to compatible to call a real OpenAI-compatible endpoint.
MYAI_FAST_MODEL_PROVIDER=local
MYAI_FAST_MODEL_NAME=placeholder-v7-fast
MYAI_FAST_MODEL_BASE_URL=http://localhost:11434
MYAI_FAST_MODEL_API_KEY=

MYAI_BALANCED_MODEL_PROVIDER=local
MYAI_BALANCED_MODEL_NAME=placeholder-v7-balanced
MYAI_BALANCED_MODEL_BASE_URL=http://localhost:11434
MYAI_BALANCED_MODEL_API_KEY=

MYAI_FRONTIER_MODEL_PROVIDER=local
MYAI_FRONTIER_MODEL_NAME=placeholder-v7-frontier
MYAI_FRONTIER_MODEL_BASE_URL=http://localhost:11434
MYAI_FRONTIER_MODEL_API_KEY=

# Agent graph budgets
MYAI_AGENT_MODE=auto
MYAI_AGENT_MAX_DEPTH=3
MYAI_AGENT_MAX_NODES=32
MYAI_AGENT_MAX_PARALLEL=4
MYAI_AGENT_MAX_RETRIES=1

MYAI_MEMORY_MAX_MESSAGES=20

# Semantic knowledge retrieval
MYAI_KNOWLEDGE_TOP_K=5
MYAI_KNOWLEDGE_CHUNK_SIZE=800
MYAI_KNOWLEDGE_CHUNK_OVERLAP=120
MYAI_KNOWLEDGE_DB_PATH=data/knowledge.sqlite3
MYAI_EMBEDDING_PROVIDER=sentence-transformers
MYAI_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Empty = auto; examples: cpu, cuda, mps
MYAI_EMBEDDING_DEVICE=

# Cognitive verification
MYAI_COGNITIVE_VERIFICATION=true
MYAI_COGNITIVE_MAX_RETRIES=1

# Code intelligence
MYAI_CODE_INDEX_ENABLED=true
MYAI_CODE_INDEX_ROOT=.
MYAI_CODE_INDEX_SNAPSHOT_PATH=data/code_index.json
MYAI_CODE_CONTEXT_LIMIT=8

# Optional provider credentials for integrations
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=

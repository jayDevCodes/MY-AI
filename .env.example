MYAI_APP_NAME=MY-AI
MYAI_ENVIRONMENT=development
MYAI_LOG_LEVEL=INFO

# V2 model routing
# local = deterministic fallback; compatible = OpenAI-compatible HTTP server
MYAI_MODEL_PROVIDER=local
MYAI_MODEL_NAME=placeholder-v2
MYAI_MODEL_BASE_URL=http://localhost:11434
MYAI_MODEL_API_KEY=
MYAI_MODEL_TIMEOUT_SECONDS=60
MYAI_MEMORY_MAX_MESSAGES=20

# Optional provider credentials for future integrations
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
